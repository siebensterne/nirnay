{
  "schema": 1,
  "purpose": "Neutral, shared quality contract for both quant workspaces. Tool pins and the listed settings are binding in each repository's own gate; a drift in a listed setting fails the standards check. `shared_files` names the files that carry those settings, not files that must be byte-identical; repository-local divergences are declared in `repo_local_files`.",
  "tools": {
    "ruff": "0.17.5",
    "pyink": "26.5.1",
    "shellcheck": "0.11.0.1",
    "rust": "1.99.1",
    "clang_format": "21.1.8",
    "cmake": "3.25",
    "ninja": "1.11",
    "clang_tidy": "21.1.8",
    "pre_commit": "4.0.0",
    "pre_commit_hooks": "v6.0.0"
  },
  "shared_files": [
    ".clang-format",
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    ".shellcheckrc",
    "ruff.toml",
    "quality-contract.json",
    "scripts/check_prose_unified.py",
    ".clang-tidy",
    ".pre-commit-config.yaml",
    "CMakeLists.txt",
    "CMakePresets.json",
    "q-style.json"
  ],
  "repo_local_files": [
    {
      "file": "ruff.toml",
      "reason": "src roots, extend-exclude paths and per-file ignores name repository-specific source trees and data paths; the pinned version, rule families and lint options remain shared"
    },
    {
      "file": "pytest.ini",
      "reason": "test discovery paths and the market-shaped-fixture deselection marker are repository-local test policy"
    },
    {
      "file": "deny.toml",
      "reason": "advisories, bans and waivers follow each repository's own dependency graph"
    },
    {
      "file": ".gitignore",
      "reason": "ignored build outputs and local worktree paths are repository-specific"
    },
    {
      "file": ".gitattributes",
      "reason": "path attributes for generated and binary files are repository-specific"
    },
    {
      "file": "git-policy.json",
      "reason": "branch, protection and ownership rules are defined per repository"
    },
    {
      "file": "constraints/",
      "reason": "resolved Python dependency pins are regenerated per repository from its own project files"
    }
  ],
  "ruff": {
    "config": "ruff.toml",
    "required_version": "==0.17.5",
    "force_exclude": true,
    "fix": false,
    "unsafe_fixes": false,
    "dummy_variable_rgx": "^_$",
    "future_annotations": true,
    "pydocstyle_convention": "google",
    "rule_families": [
      "E",
      "F",
      "W",
      "I",
      "N",
      "D",
      "UP",
      "B",
      "SIM",
      "C4",
      "BLE",
      "PIE",
      "RET",
      "RUF",
      "ANN"
    ]
  },
  "shellcheck": {
    "config": ".shellcheckrc",
    "shell": "bash",
    "external_sources": true,
    "optional_checks": [
      "add-default-case",
      "avoid-negated-conditions",
      "avoid-nullary-conditions",
      "deprecate-which",
      "quote-safe-variables",
      "require-double-brackets",
      "useless-use-of-cat"
    ]
  },
  "editorconfig": {
    "root": true,
    "charset": "utf-8",
    "end_of_line": "lf",
    "insert_final_newline": true,
    "trim_trailing_whitespace": true
  },
  "rust": {
    "denied_rust_lints": [
      "unsafe_code",
      "unsafe_op_in_unsafe_fn",
      "unexpected_cfgs"
    ],
    "denied_clippy_lints": [
      "unwrap_used",
      "expect_used",
      "panic",
      "todo",
      "unimplemented",
      "dbg_macro",
      "print_stdout",
      "redundant_else",
      "needless_raw_string_hashes"
    ]
  },
  "xtask": {
    "crate": "xtask/Cargo.toml",
    "required_tasks": [
      "style",
      "fmt",
      "lint",
      "test",
      "docs",
      "check",
      "ci",
      "list"
    ],
    "typed_argv": true,
    "generated_help": true,
    "self_tests": true,
    "fail_closed": true,
    "locked_alias": true
  }
}
