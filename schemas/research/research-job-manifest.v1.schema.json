{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nirnay.invalid/schemas/research/research-job-manifest.v1.schema.json",
  "title": "Local opt-in research job manifest v1",
  "description": "Declarative, checked-in research job inputs. This schema describes a local opt-in runner, not a scheduler service, distributed executor or resource allocator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "jobs": {
      "type": "array",
      "minItems": 0,
      "description": "An empty array is a valid retired manifest: no job may run until a job bound to an already admitted dataset is registered.",
      "items": {
        "$ref": "#/$defs/job"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[^:]+:[0-9a-f]{16}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "python_constraint_file",
        "constraint_sha256",
        "code_paths",
        "code_digest"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "pattern": "^3\\.12(\\.[0-9]+)?$"
        },
        "python_constraint_file": {
          "type": "string",
          "minLength": 1
        },
        "constraint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "code_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_digest": {
          "$ref": "#/$defs/sha256"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "dataset_ref",
        "dataset_id",
        "dataset_version",
        "dataset_sha256",
        "code_digest",
        "constraint_file",
        "command",
        "schedule_hint",
        "dry_run"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "dataset_ref": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "$ref": "#/$defs/version"
        },
        "dataset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "code_digest": {
          "$ref": "#/$defs/sha256"
        },
        "constraint_file": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schedule_hint": {
          "enum": [
            "manual-opt-in",
            "ci-nightly-hint"
          ]
        },
        "dry_run": {
          "const": true
        }
      }
    }
  }
}
